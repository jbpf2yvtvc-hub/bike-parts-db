# ---------------------------------------------------------------------------
# Bike Parts DB — environment variables
#
# These are SERVER-ONLY. Do NOT prefix with VITE_ — that would inline the
# value into the client bundle and leak it to the browser.
#
# In production set these in the Cloudflare Pages dashboard (Settings ->
# Environment variables). Locally, copy this file to client/.env
# ---------------------------------------------------------------------------

# URL of the PocketBase instance. Local dev default shown below; in production
# point this at your Railway/Render deployment, e.g. https://your-app.railway.app
POCKETBASE_URL=http://127.0.0.1:8090

# 32+ character random string used to sign/secure the session.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# Optional: PocketBase superuser credentials, used ONLY by server-side admin
# operations if you choose to enable them. Leave unset for owner-scoped rules.
# PB_ADMIN_EMAIL=
# PB_ADMIN_PASSWORD=
